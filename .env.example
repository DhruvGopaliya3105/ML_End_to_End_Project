# ============================================================
# Sanjeevani Clinic - environment settings
# ============================================================
# Copy this file to ".env" and fill in your own values:
#
#     cp .env.example .env
#
# The .env file is git-ignored, so your real passwords stay out of git.
# ============================================================


# ------------------------------------------------------------
# 1. DATABASE
# ------------------------------------------------------------
# Put your own MySQL password below. These are the settings the app
# reads first. If MySQL cannot be reached, the app FALLS BACK TO SQLITE
# and shows a loud warning in the console - check the startup logs and
# the /health page to see which database is really being used.

USE_SQLITE=false
DB_USER=sanjeevani_app
DB_PASSWORD=
DB_HOST=l
DB_PORT=3306
DB_NAME=


# Set this to true ONLY if you deliberately want to use the local
# SQLite file (sanjeevani_clinic.db) instead of MySQL.
USE_SQLITE=false


# ------------------------------------------------------------
# 2. SESSION SECRET
# ------------------------------------------------------------
# Used to sign the login session cookie. Change it to any long
# random string. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"

SESSION_SECRET=change_this_to_a_long_random_secret


# ------------------------------------------------------------
# 3. AI FEATURES (GROQ)
# ------------------------------------------------------------
# Optional. The app runs fine without it - chatbot replies, AI health
# screening and injury analysis simply stay switched off and tell you so.
#
# Free key: https://console.groq.com/keys

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b


# ------------------------------------------------------------
# 4. OPTIONAL
# ------------------------------------------------------------

# Set to DEBUG for more verbose logs
LOG_LEVEL=INFO

# Where pytesseract can find the Tesseract binary (only needed for
# OCR of scanned medical reports). Leave commented out to use PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe


# ------------------------------------------------------------
# 5. PHARMACY (optional - everything works without these)
# ------------------------------------------------------------
# The pharmacy module (/pharmacy, /pharmacy/admin) runs fully offline:
# the emergency "find it nearby" list is read from the SQL tables
# nearby_pharmacies + nearby_pharmacy_stocks. These keys only add extras.

# Google Maps / Places key -> live "chemist near me" results in the emergency
# search, and the "Import from Google" button in Pharmacy admin -> Nearby.
# Free tier: https://console.cloud.google.com/apis/credentials
# Enable "Places API" (Text Search + Details). Leave empty to skip Google.
GOOGLE_MAPS_API_KEY=

# Where "near me" is measured from (used for the distance column and the
# Google search centre). Jaipur clinic coordinates are the default.
CLINIC_LATITUDE=26.9124
CLINIC_LONGITUDE=75.7873
CLINIC_CITY=Jaipur
PHARMACY_NEARBY_RADIUS_M=5000

# Payment. With no keys the pharmacy uses the simulated UPI/QR flow (the same
# approach the appointment page already uses), so "Pay online" works on a demo
# machine. Put test/live keys here and the very same button becomes a real
# Razorpay checkout whose signature is verified on the server before an order
# is confirmed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shown on the order page for the cash / UPI instructions
PHARMACY_UPI_ID=sanjeevani.pharmacy@upi
PHARMACY_COUNTER_NAME=Sanjeevani Clinic Pharmacy
PHARMACY_QR_IMAGE=/static/images/dummy_payment_qr.png

# Only used by test_pharmacy.py so the smoke test can run against a throwaway
# file instead of sanjeevani_clinic.db. Leave this commented out normally.
# SQLITE_DB_PATH=sanjeevani_clinic.db
