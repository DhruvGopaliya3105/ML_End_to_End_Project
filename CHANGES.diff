+ALLOWED_SPECIALISATIONS = [
+    "Cardiology",
+    "Dentistry",
+    "Dermatology",
+    "ENT",
+    "General Medicine",
+    "Gynecology",
+    "Neurology",
+    "Ophthalmology",
+    "Orthopedics",
+    "Pediatrics",
+]
+
+ALLOWED_SEVERITIES = ["Mild", "Moderate", "Urgent"]
+
+
+SCREENING_PROMPT = """
+You are a careful medical triage assistant for Sanjeevani Clinic.
+
+The patient describes their symptoms. Produce a PRELIMINARY triage assessment.
+
+You MUST reply with ONLY a JSON object, no markdown, no extra text:
+
+{
+  "care_category": "<one of the allowed specialisations>",
+  "recommended_specialist": "<short human readable specialist title>",
+  "severity": "<Mild | Moderate | Urgent>",
+  "guidance": "<2 to 4 sentences of safe, general guidance in simple English>"
+}
+
+SAFETY RULES:
+- This is preliminary triage only, never a diagnosis.
+- Do NOT prescribe medicine names or dosages.
+- If red-flag symptoms are described (chest pain, difficulty breathing,
+  fainting, severe bleeding, stroke signs, very high fever, suicidal
+  thoughts), set severity to "Urgent" and clearly advise immediate
+  in-person or emergency care.
+- Otherwise prefer "Mild" or "Moderate". Do not over-use "Urgent".
+
+Care category MUST be exactly one of:
+{specialisations}
+"""
+
+
+def generate_screening_assessment(symptoms: str):
+    """Return an AI triage assessment, or None if AI is unavailable.
+
+    Callers should fall back to their own rule-based assessment when this
+    returns None, and tell the user that the AI was not used.
+    """
+
+    import json
+
+    if not client.configured:
+
+        return None
+
+    prompt = SCREENING_PROMPT.format(
+        specialisations=", ".join(ALLOWED_SPECIALISATIONS)
+    )
+
+    try:
+
+        response = client.chat.completions.create(
+
+            model=MODEL_NAME,
+
+            messages=[
+                {
+                    "role": "system",
+                    "content": prompt
+                },
+                {
+                    "role": "user",
+                    "content": (
+                        "Patient symptoms: "
+                        f"{symptoms}"
+                    )
+                }
+            ],
+
+            temperature=0.2,
+
+            max_tokens=500
+        )
+
+        raw = (
+            response
+            .choices[0]
+            .message
+            .content
+            or ""
+        ).strip()
+
+        # Tolerate ```json fences if the model adds them.
+        if raw.startswith("```"):
+
+            raw = raw.strip("`")
+
+            if raw.lower().startswith("json"):
+
+                raw = raw[4:]
+
+            raw = raw.strip()
+
+        data = json.loads(raw)
+
+    except Exception as e:
+
+        print(f"Screening AI error: {str(e)}")
+
+        return None
+
+    care_category = str(
+        data.get("care_category", "")
+    ).strip()
+
+    severity = str(
+        data.get("severity", "")
+    ).strip().title()
+
+    guidance = str(
+        data.get("guidance", "")
+    ).strip()
+
+    # Reject anything that would break the doctor-matching step.
+    if care_category not in ALLOWED_SPECIALISATIONS:
+
+        return None
+
+    if severity not in ALLOWED_SEVERITIES:
+
+        severity = "Moderate"
+
+    if not guidance:
+
+        return None
+
+    return {
+
+        "care_category":
+            care_category,
+
+        "recommended_specialist":
